# Python (le paquet serie/dcon est lancé directement, jamais installé)
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/

# Éditeurs et outils
.vscode/
.idea/
.claude/settings.local.json
*.swp
*~

# Système
.DS_Store
Thumbs.db

# Sorties locales (relevés série, journaux de diagnostic)
*.log
*.tmp

# Les traces du chantier sont des pièces, pas des sorties jetables.
!chantier/traces/*.log
# Sauf le report de console d'une boucle détachée : c'est un doublon de
# stdout, et la boucle le commiterait pendant qu'il s'écrit encore.
chantier/traces/boucle-*.log
