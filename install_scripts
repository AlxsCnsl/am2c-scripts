#!/usr/bin/env bash
#
# install_scripts — Télécharge le dépôt am2c-scripts dans le dossier courant.
#
# Usage :
#   cd <là où on veut les scripts>
#   ~/Téléchargements/install_scripts
#
# Seule dépendance vérifiée : git.
#
# By :
# > alexis consolo (alexis.consolo@outlook.com)
#

set -euo pipefail

info()  { printf '\n\033[1;36m==>\033[0m %s\n' "$1"; }
ok()    { printf '\033[1;32m  OK\033[0m %s\n' "$1"; }
err()   { printf '\033[1;31m  !!\033[0m %s\n' "$1" >&2; }

DEPOT="https://github.com/AlxsCnsl/am2c-scripts.git"
DOSSIER="am2c-scripts"

# --- Dépendances -----------------------------------------------------------
info "Vérification des dépendances ..."
if ! command -v git >/dev/null 2>&1; then
    err "git est introuvable. Installez-le puis relancez :"
    err "  sudo apt install git"
    exit 1
fi
ok "git est présent ($(git --version))."

# --- Téléchargement --------------------------------------------------------
if [ -e "$DOSSIER" ]; then
    err "Le dossier « $DOSSIER » existe déjà ici : $(pwd)"
    err "Supprimez-le ou placez-vous ailleurs, puis relancez."
    exit 1
fi

info "Téléchargement de $DEPOT dans $(pwd)/$DOSSIER ..."
git clone "$DEPOT" "$DOSSIER"
ok "Scripts installés dans $(pwd)/$DOSSIER"

printf '\nPour commencer :\n  cd %s\n  ./lancer-adam.sh\n\n' "$DOSSIER"
